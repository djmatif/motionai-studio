# Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy anon key fallback for existing deployments.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# fal.ai: https://fal.ai/dashboard/keys
FAL_KEY=

# Stripe: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_STUDIO_MONTHLY=

# Public app URL, e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to a long random secret for cron/admin tasks if you add them
APP_SECRET=

# Admin: use the same email for your Supabase Auth account.
# Set your password for this account in Supabase Auth or via the login page.
# Admin generations bypass app credits; provider usage is still billed to your fal account.
ADMIN_EMAIL=your-admin-email@example.com
